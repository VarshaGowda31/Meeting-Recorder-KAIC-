import { useState, useEffect } from "react";
import "./App.css";

function App() {

  const [recording, setRecording] = useState(false);
  const [transcript, setTranscript] = useState("");
  const [summary, setSummary] = useState("");
  const [tasks, setTasks] = useState([]);

  const [seconds, setSeconds] = useState(0);
  const [darkMode, setDarkMode] = useState(false);

  useEffect(() => {                
    let timer;

    if (recording) {

      timer = setInterval(() => {

        setSeconds((prev) => prev + 1);

      }, 1000);

    }

    return () => clearInterval(timer);

  }, [recording]);



  function startRecording() {

    setRecording(true);

    setSeconds(0);

    setTranscript(" Listening... Speech will appear here.");

    setSummary("");

    setTasks([]);

  }



  function stopRecording() {

    setRecording(false);

    setTranscript(
      "Meeting discussed project requirements, deadlines and implementation steps."
    );

    setSummary(
      "The team discussed project planning, assigned development work, and finalized the next implementation steps."
    );

    setTasks([
      "Completes",

    ]);

  }



  function clearNotes() {

    setTranscript("");

    setSummary("");

    setTasks([]);

    setSeconds(0);

  }

  function copyNotes() {

    navigator.clipboard.writeText(

      `Transcript:\n${transcript}\n\nSummary:\n${summary}\n\nTasks:\n${tasks.join("\n")}`

    );

    alert("Notes copied!");

  }

  return (

    <div className={darkMode ? "app dark" : "app"}>

      <button
        className="theme-btn"
        onClick={() => setDarkMode(!darkMode)}
      >
        {darkMode ? "Light Mode" : "Dark Mode"}
      </button>

      <h1> Meeting Recorder</h1>

      <p className="subtitle">
        Record • Transcribe • Summarize
      </p>

      <p className="date">
         {new Date().toLocaleDateString()}
      </p>

      {/* Statistics */}

      <div className="stats">

        <div className="stat-card">

          <h3> Duration</h3>

          <p>{seconds} sec</p>

        </div>

        <div className="stat-card">

          <h3> Words</h3>

          <p>

            {transcript
              ? transcript.split(" ").length
              : 0}

          </p>

        </div>

        <div className="stat-card">

          <h3> Tasks</h3>

          <p>{tasks.length}</p>

        </div>

      </div>

      <div className="record-box">

        <button

          onClick={

            recording

              ? stopRecording

              : startRecording

          }

          className={

            recording

              ? "stop"

              : "start"

          }

        >

          {

            recording

              ? " Stop Recording"

              : " Start Recording"

          }

        >

        </button>

        <p>

          Status :

          {

            recording

              ? "  Recording..."

              : " Ready"

          }

        </p>

        <p className="timer">

          {seconds} sec

        </p>

        <div className="buttons">

          <button
            className="clear"
            onClick={clearNotes}
          >
            Clear
          </button>

          <button
            className="copy"
            onClick={copyNotes}
          >
             Copy Notes
          </button>

        </div>

      </div>

      <div className="cards">

        <div className="card">

          <h2>Transcript</h2>

          <div className="content-box">

            {

              transcript ||

              "No transcript yet"

            }

          </div>

        </div>

        <div className="card">

          <h2> AI Summary</h2>

          <div className="content-box">

            {

              summary ||

              "Summary will appear here"

            }

          </div>

        </div>

        <div className="card">

          <h2> Action Items</h2>

          {

            tasks.length === 0 ?

              (

                <p>No tasks available.</p>

              )

              :

              (

                <ul>

                  {

                    tasks.map(

                      (task, index) => (

                        <li key={index}>

                          {task}

                        </li>

                      )

                    )

                  }

                </ul>

              )

          }

        </div>

      </div>

    </div>

  );

}

export default App;
